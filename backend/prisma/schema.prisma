generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  googleId         String            @unique
  email            String            @unique
  name             String
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  batches          EmailBatch[]
  senders          Sender[]
  slackIntegration SlackIntegration?
}

model Sender {
  id         String     @id @default(uuid())
  userId     String
  fromEmail  String
  smtpHost   String
  smtpPort   Int
  smtpUser   String
  smtpPass   String
  maxPerHour Int        @default(200)
  minDelayMs Int        @default(2000)
  createdAt  DateTime   @default(now())
  emails     EmailJob[]
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailBatch {
  id          String     @id @default(uuid())
  userId      String
  subject     String
  body        String
  startTime   DateTime
  delayMs     Int
  hourlyLimit Int
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id])
  emails      EmailJob[]
}

model EmailJob {
  id           String      @id @default(uuid())
  batchId      String
  senderId     String
  toEmail      String
  subject      String
  body         String
  scheduledFor DateTime
  status       EmailStatus @default(SCHEDULED)
  bullJobId    String?     @unique
  version      Int         @default(1)
  attempts     Int         @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  batch        EmailBatch  @relation(fields: [batchId], references: [id])
  sender       Sender      @relation(fields: [senderId], references: [id])

  @@index([senderId, status])
  @@index([scheduledFor])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  accessToken String
  webhookUrl  String?
  channelId   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RESCHEDULED
}
